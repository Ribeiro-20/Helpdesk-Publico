# BASE Monitor – environment variables template
# Copy to .env and fill in real values.

# Supabase (local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# App URLs
APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# BASE / Diário da República ingestion
BASE_API_URL=https://www.base.gov.pt/APIBase2
BASE_API_TOKEN=<portal-base-token>
DR_DAILY_URL=auto
TENANT_ID=

# Admin/bootstrap
DEFAULT_TENANT_NAME=Default
ADMIN_SEED_SECRET=<change-me>

# Email (dev using Mailpit)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=noreply@localhost
MAILPIT_URL=http://host.docker.internal:54324
SENDGRID_API_KEY=<sendgrid-api-key>

# Notes:
# - Copy this file to .env and fill the placeholders before running locally.
# - Keep secrets out of version control.
